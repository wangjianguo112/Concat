<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- fusion 新增：AI 生成页要访问局域网里的 fusion-gateway -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Concat Fusion"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- fusion 新增：AI 一键成片入口页 -->
        <activity
            android:name="app.concat.editor.aicut.AiActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
